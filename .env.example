# Local dev only (Vite). Copy to `.env.local` or set in shellui/dev compose.
# Browser-facing origins (http://localhost:<host port> per the dev stack contract).

# storage-service (host port 8002)
VITE_STORAGE_URL=http://localhost:8002

# identity-service (host port 8001). The host shell uses this for sign-in; optional here for tooling.
VITE_IDENTITY_URL=http://localhost:8001

# macOS bind mounts: set to true when file changes are not detected inside Docker.
# VITE_USE_POLLING=true

# Published dev-server origin and port (defaults: http://localhost:5175).
# VITE_DEV_ORIGIN=http://localhost:5175
# VITE_DEV_PORT=5175
