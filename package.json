{
  "name": "shellui-files",
  "version": "0.2.1",
  "description": "Shellui file manager — embedded in the admin panel; file ops go through @shellui/sdk",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "build:sdk": "pnpm -C ../shellui run build:sdk"
  },
  "author": "Shellui",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@shellui/sdk": "0.5.0-alpha.5",
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
