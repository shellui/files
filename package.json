{
  "name": "shellui-files",
  "version": "0.3.0",
  "description": "Shellui file manager, embedded in the admin panel; file ops go through @shellui/sdk",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "build:sdk": "pnpm -C ../shellui run build:sdk"
  },
  "author": "Shellui",
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@shellui/sdk": "0.8.1",
    "i18next": "^27.2.9",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.7.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
